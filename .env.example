# ── Responses API 配置(拿到 key 后把这个文件复制为 .env 并填好)───────────
# OpenAI 或兼容中转站的 API 根地址。可填到域名或 /v1,程序会补 /responses。
PPT_API_BASE_URL=https://api.openai.com/v1
PPT_API_KEY=
PPT_WIRE_API=responses

# 必须是该接口实际支持函数调用的模型。
PPT_MODEL=gpt-5.6

# ── 备选模型(可选;前端下拉可切换,用于对比不同模型)────────────────────
# PPT_MODEL2..9 依此类推。WIRE 取 responses(OpenAI Responses API)或
# chat(OpenAI Chat Completions 兼容端点,如 DeepSeek 官方)。
# PPT_MODEL2=deepseek-v4-pro
# PPT_MODEL2_LABEL=DeepSeek V4 Pro(官方直连)
# PPT_MODEL2_BASE_URL=https://api.deepseek.com
# PPT_MODEL2_API_KEY=sk-xxxx
# PPT_MODEL2_WIRE=chat
# 图片输入能力(Agent 用 view_image 亲眼看材料图片再排版)。
# 默认:responses 协议开、chat 协议关(DeepSeek 官方实测拒收图片);
# 支持视觉的 chat 端点可显式打开:
# PPT_MODEL2_VISION=1
# 默认模型的开关则是 PPT_VISION=0/1
# 单任务 view_image 看图次数上限(控 token,默认 12):
# PPT_VIEW_IMAGE_MAX=12
# 可选费率(美元/百万 token),配置后任务卡显示估算费用;
# _CACHED 是缓存命中价(不配则缓存按输入价计,长任务会显著虚高):
# PPT_MODEL2_INPUT_USD_PER_M=
# PPT_MODEL2_OUTPUT_USD_PER_M=
# PPT_MODEL2_CACHED_USD_PER_M=
# 默认模型对应 PPT_INPUT_USD_PER_M / PPT_OUTPUT_USD_PER_M / PPT_CACHED_USD_PER_M

# 兼容旧配置:没有 PPT_API_* 时,程序也会读取 OPENAI_BASE_URL/OPENAI_API_KEY,
# 以及 ANTHROPIC_BASE_URL/ANTHROPIC_AUTH_TOKEN/ANTHROPIC_API_KEY。

# ── AI 配图(文生图,可选)──────────────────────────────────────────────
# 配置后前端出现「AI 生成配图」开关(按任务勾选,按张计费)。
# 走 openai 兼容 /v1/images/generations;模型名以你的网关为准(如 gpt-image-2)。
# 地址与 key 缺省复用上面的主 API 配置,仅在图像走别的服务商时单独填。
# PPT_IMAGE_MODEL=gpt-image-2
# PPT_IMAGE_BASE_URL=
# PPT_IMAGE_API_KEY=
# 可选画质(gpt-image 系:low/medium/high;不设则不传,由后端默认)
# PPT_IMAGE_QUALITY=
# 图片格式(png/jpeg/webp;默认 png,避免文件扩展名与实际内容不一致)
# PPT_IMAGE_FORMAT=png

# ── 服务配置(一般不用改)────────────────────────────────────────────────
# 生成引擎位置。默认使用项目内置的 engine/(自包含),一般留空即可;
# 只有要指向外部引擎仓库时才需要设置。
# PPT_MASTER_REPO=

# 公司模板原稿 PPTX(原生母版来源)。公司蓝任务的成品第 1、2 页由系统
# 直接取自该文件的原生封面/目录页;不填则退回引擎内的模板预览稿。
# 相对路径按项目根解析,也可填绝对路径。项目已内置一份:
COMPANY_TEMPLATE_SOURCE=data/company/MT PPT模板_2023_副本.pptx

# mock 模式: auto = 没配 key 就用假跑演示;off = 强制真跑;force = 强制假跑
MOCK_MODE=auto

# Web 端口
PORT=8080

# 生产部署可把运行时账号库、材料、任务和成品放到 release 之外。
# 本地留空即可；服务器使用 /opt/ppt-web/data。
# PPT_DATA_DIR=

# Nginx 子路径前缀。本地留空；服务器使用 /ppt-generator。
# PPT_BASE_PATH=

# 单个任务超时(分钟),超时強制结束并标记失败
JOB_TIMEOUT_MINUTES=90

# 任务并发数:1=串行(默认,费用最可控);2-4=并行跑多个任务,
# 适合同一份大纲用多个模型对比;注意 API 并发与费用同时叠加。
JOB_WORKERS=1

# PPT Master 脚本用的 Python 解释器。必须带该仓库 requirements(Pillow 等);
# 留空则用 PATH 上的 python3,但服务的 PATH 随启动方式变化,建议显式指定。
PPT_PYTHON_BIN=

# 可选高级项
PPT_API_REQUEST_TIMEOUT_SECONDS=300
# 瞬时错误(5xx/429/断连/超时)重试次数,指数退避 5/10/20/40/60s
PPT_API_RETRIES=5
PPT_AGENT_MAX_TURNS=240
PPT_MAX_OUTPUT_TOKENS=32768
PPT_COMPACT_THRESHOLD=180000
