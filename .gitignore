# 机密:.env 含 API token,绝不入库
.env

# Python / macOS
__pycache__/
*.py[cod]
.venv/
.DS_Store

# 运行时数据(账号库/材料库/任务快照/产物/日志/状态/手工 QA 渲染)
data/app.db*
data/library/
data/uploads/
data/outputs/
data/logs/
data/jobs.json*
data/server.log
data/server.out
data/qa/

# 示例成品画廊(约 75MB 预渲染 SVG,来源与重建方法见 data/examples/README.md;不入库)
data/examples/*
!data/examples/README.md

# 引擎任务工作区(生成产物;README 保留)
engine/projects/*
!engine/projects/README.md

# Claude Code 会话产物
.claude/
